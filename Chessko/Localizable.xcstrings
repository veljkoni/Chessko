            "value": "Roque tardif"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu spätes Rochieren"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrocco tardivo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запоздалая рокировка"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "王车易位太晚"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "देर से कैसलिंग"
          }
        }
      }
    },
    "Svaki potez bez rokade kada su linije otvorene je rizik. Protivnik može otvoriti igru i napasti tvog kralja pre nego što se skloni.": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaki potez bez rokade kada su linije otvorene je rizik. Protivnik može otvoriti igru i napasti tvog kralja pre nego što se skloni."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every move without castling while the lines are open is a risk. The opponent can open the position and attack your king before it gets to safety."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque coup sans roque alors que les lignes sont ouvertes est un risque. L’adversaire peut ouvrir le jeu et attaquer votre roi avant qu’il ne soit à l’abri."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Zug ohne Rochade bei offenen Linien ist ein Risiko. Der Gegner kann das Spiel öffnen und deinen König angreifen, bevor er in Sicherheit ist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni mossa senza arrocco con le linee aperte è un rischio. L’avversario può aprire il gioco e attaccare il tuo re prima che si metta al sicuro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый ход без рокировки при открытых линиях — риск. Соперник может вскрыть позицию и атаковать вашего короля раньше, чем он укроется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在线路开放时每走一步而不易位都是冒险。对手可能打开局面，在你的国王到达安全之前发起攻击。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब लाइनें खुली हों तब बिना कैसलिंग की हर चाल जोखिम है। विरोधी खेल खोलकर आपके राजा के सुरक्षित होने से पहले हमला कर सकता है।"
          }
        }
      }
    },
    "Odigraj svaki potez belih na tabli — crni odgovara automatski po teorijskoj liniji.": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odigraj svaki potez belih na tabli — crni odgovara automatski po teorijskoj liniji."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play each of White’s moves on the board — Black replies automatically along the theoretical line."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouez chaque coup des Blancs sur l’échiquier — les Noirs répondent automatiquement selon la ligne théorique."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiele jeden Zug von Weiß auf dem Brett — Schwarz antwortet automatisch nach der theoretischen Linie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gioca ogni mossa del Bianco sulla scacchiera — il Nero risponde automaticamente seguendo la linea teorica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сыграйте каждый ход белых на доске — чёрные отвечают автоматически по теоретической линии."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在棋盘上走出白方的每一步——黑方按理论线路自动应着。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बोर्ड पर सफ़ेद की हर चाल खेलें — काला सैद्धांतिक लाइन के अनुसार स्वतः जवाब देता है।"
          }
        }
      }
    },
