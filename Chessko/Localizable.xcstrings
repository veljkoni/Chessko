    "Poraz — pokušaj ponovo.": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poraz — pokušaj ponovo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Defeat — try again."
