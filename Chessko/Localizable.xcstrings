    },
    "Remi — pazi na pat! Pokušaj ponovo.": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remi — pazi na pat! Pokušaj ponovo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw — watch for stalemate! Try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nulle — attention au pat ! Réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Remis — Vorsicht vor Patt! Versuch es nochmal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Patta — attento allo stallo! Riprova."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничья — берегитесь пата! Попробуйте снова."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平局——小心逼和！再试一次。"
