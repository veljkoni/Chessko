    "Ova aplikacija je otvorenog koda, koristi Stockfish šahovski pokretač pod GPLv3 licencom i preuzima šahovske zadatke iz slobodne Lichess baze." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App ist Open-Source, nutzt die Stockfish-Engine unter GPLv3 und lädt Aufgaben aus der freien Lichess-Datenbank."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app is open-source, runs the Stockfish engine under GPLv3, and fetches puzzles from the free Lichess database."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette application est open-source, utilise le moteur Stockfish sous GPLv3 et récupère les problèmes de la base libre Lichess."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह ऐप ओपन-सोर्स है, GPLv3 के तहत स्टॉकफ़िश इंजन चलाता है, और मुफ़्त Lichess डेटाबेस से पहेलियाँ प्राप्त करता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa app è open-source, utilizza il motore Stockfish sotto licenza GPLv3 e scarica i problemi dal database gratuito di Lichess."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это приложение с открытым исходным кодом, использует шахматный движок Stockfish под лицензией GPLv3 и загружает задачи из свободной базы Lichess."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ova aplikacija je otvorenog koda, koristi Stockfish šahovski pokretač pod GPLv3 licencom i preuzima šahovske zadatke iz slobodne Lichess baze."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本应用为开源软件，在 GPLv3 许可下运行 Stockfish 引擎，并从免费的 Lichess 数据库获取谜题。"
          }
        }
      }
    },
