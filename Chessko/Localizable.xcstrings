    "Ponavljanje pozicije": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponavljanje pozicije"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repetition of position"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répétition de position"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellungswiederholung"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripetizione di posizione"
          }
        },
        "ru": {
