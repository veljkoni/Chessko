    "Pobedio je jednostavnošću i savršenom tehnikom — ne agresijom.": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobedio je jednostavnošću i savršenom tehnikom — ne agresijom."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "He won through simplicity and perfect technique — not aggression."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il gagnait par la simplicité et une technique parfaite — non par l’agressivité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er gewann durch Einfachheit und perfekte Technik — nicht durch Aggression."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinceva con la semplicità e una tecnica perfetta — non con l’aggressività."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он побеждал простотой и безупречной техникой — не агрессией."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "他靠简洁和完美的技术取胜——而非凶猛进攻。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उन्होंने सरलता और उत्तम तकनीक से जीत हासिल की — आक्रामकता से नहीं।"
          }
        }
      }
    },
