    "Ako se ista pozicija ponovi **tri puta**, može se tražiti remi.": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako se ista pozicija ponovi **tri puta**, može se tražiti remi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the same position occurs **three times**, a draw can be claimed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la même position se répète **trois fois**, la nulle peut être réclamée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederholt sich dieselbe Stellung **dreimal**, kann Remis beansprucht werden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se la stessa posizione si ripete **tre volte**, si può richiedere la patta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если одна и та же позиция повторяется **три раза**, можно требовать ничью."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果同一局面出现**三次**，可以要求和棋。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि वही स्थिति **तीन बार** आती है, तो ड्रॉ का दावा किया जा सकता है。"
          }
        }
      }
    },
    "Samo Kraljevi, ili Kralj + Lovac/Skakač protiv Kralja — nije moguće dati mat. Automatski remi.": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo Kraljevi, ili Kralj + Lovac/Skakač protiv Kralja — nije moguće dati mat. Automatski remi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only kings, or king + bishop/knight against king — checkmate is impossible. Automatic draw."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les rois, ou roi + fou/cavalier contre roi — le mat est impossible. Nulle automatique."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Könige, oder König + Läufer/Springer gegen König — Matt ist unmöglich. Automatisches Remis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo i re, oppure re + alfiere/cavallo contro re — il matto è impossibile. Patta automatica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только короли, или король + слон/конь против короля — мат невозможен. Автоматическая ничья."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只剩双王，或王 + 象/马 对王——无法将杀。自动和棋。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल राजा, या राजा + ऊँट/घोड़ा बनाम राजा — शहमात संभव नहीं। स्वतः ड्रॉ।"
          }
        }
      }
    },
    "Primeni sve što si naučio! Reši 5 zadataka — mat u najmanji broj poteza. Svaki koristi drugu kombinaciju figura.": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeni sve što si naučio! Reši 5 zadataka — mat u najmanji broj poteza. Svaki koristi drugu kombinaciju figura."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply everything you’ve learned! Solve 5 puzzles — mate in the fewest moves. Each uses a different combination of pieces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliquez tout ce que vous avez appris ! Résolvez 5 problèmes — mat en un minimum de coups. Chacun utilise une combinaison de pièces différente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wende alles an, was du gelernt hast! Löse 5 Aufgaben — Matt in möglichst wenigen Zügen. Jede nutzt eine andere Figurenkombination."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Applica tutto ciò che hai imparato! Risolvi 5 problemi — matto nel minor numero di mosse. Ognuno usa una diversa combinazione di pezzi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Примените всё, что узнали! Решите 5 задач — мат в наименьшее число ходов. В каждой своя комбинация фигур."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运用你学到的一切！解开 5 道谜题——用最少的步数将杀。每道使用不同的棋子组合。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो कुछ सीखा है उसे लागू करें! 5 पहेलियाँ हल करें — सबसे कम चालों में मात। हर एक में मोहरों का अलग संयोजन है।"
          }
        }
      }
    },
