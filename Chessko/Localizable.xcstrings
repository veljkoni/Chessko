          }
        }
      }
    },
    "Nedovoljno materijala": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedovoljno materijala"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Insufficient material"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Matériel insuffisant"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungenügendes Material"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Materiale insufficiente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостаточно материала"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "子力不足"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपर्याप्त सामग्री"
          }
        }
      }
    },
    "Kreće se jedno polje napred. Uzima figuru dijagonalno ispred sebe. Sa startne pozicije može da skoči i dva polja odjednom.": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreće se jedno polje napred. Uzima figuru dijagonalno ispred sebe. Sa startne pozicije može da skoči i dva polja odjednom."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It moves one square forward. It captures a piece diagonally in front of it. From its starting position it may jump two squares at once."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il avance d’une case. Il capture une pièce en diagonale devant lui. Depuis sa case de départ, il peut avancer de deux cases d’un coup."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zieht ein Feld vorwärts. Er schlägt eine Figur diagonal vor sich. Von seinem Startfeld darf er zwei Felder auf einmal vorrücken."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avanza di una casa. Cattura un pezzo in diagonale davanti a sé. Dalla posizione iniziale può saltare due case in una volta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ходит на одно поле вперёд. Бьёт фигуру по диагонали перед собой. С начальной позиции может пойти сразу на два поля."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向前走一格。斜前方吃子。从起始位置可一次跳两格。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह एक खाना आगे चलता है। अपने सामने तिरछे मोहरा मारता है। शुरुआती स्थिति से एक बार में दो खाने कूद सकता है।"
          }
        }
      }
    },
    "Kreće se horizontalno ili vertikalno, koliko god polja želi. Ne može preskakati figure.": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreće se horizontalno ili vertikalno, koliko god polja želi. Ne može preskakati figure."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It moves horizontally or vertically, as many squares as it likes. It cannot jump over pieces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle se déplace horizontalement ou verticalement, autant de cases qu’elle veut. Elle ne peut pas sauter par-dessus les pièces."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zieht waagerecht oder senkrecht, beliebig weit. Er kann keine Figuren überspringen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si muove in orizzontale o verticale, per quante case vuole. Non può saltare i pezzi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ходит по горизонтали или вертикали на любое число полей. Не может перепрыгивать фигуры."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "横向或纵向走任意格数。不能跳过棋子。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह क्षैतिज या लंबवत, जितने चाहे खाने चलता है। यह मोहरों के ऊपर से नहीं कूद सकता।"
          }
        }
      }
    },
    "Kreće se u obliku slova L: dva polja u jednom pravcu pa jedno bočno. Jedina figura koja može preskočiti druge.": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreće se u obliku slova L: dva polja u jednom pravcu pa jedno bočno. Jedina figura koja može preskočiti druge."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It moves in an L shape: two squares in one direction, then one to the side. The only piece that can jump over others."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il se déplace en forme de L : deux cases dans une direction puis une sur le côté. La seule pièce qui peut sauter par-dessus les autres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zieht in L-Form: zwei Felder in eine Richtung, dann eins zur Seite. Die einzige Figur, die über andere springen kann."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si muove a forma di L: due case in una direzione poi una di lato. L’unico pezzo che può saltare gli altri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ходит буквой «Г»: два поля в одну сторону, затем одно вбок. Единственная фигура, способная перепрыгивать через другие."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "走 L 形：朝一个方向走两格，再横走一格。唯一能跳过其他棋子的棋子。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह L आकार में चलता है: एक दिशा में दो खाने फिर एक बगल में। एकमात्र मोहरा जो दूसरों के ऊपर से कूद सकता है।"
          }
        }
      }
    },
    "Kreće se dijagonalno, koliko god polja želi. Uvek ostaje na istoj boji polja.": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreće se dijagonalno, koliko god polja želi. Uvek ostaje na istoj boji polja."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It moves diagonally, as many squares as it likes. It always stays on the same colour of square."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il se déplace en diagonale, autant de cases qu’il veut. Il reste toujours sur la même couleur de case."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zieht diagonal, beliebig weit. Er bleibt immer auf der gleichen Feldfarbe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si muove in diagonale, per quante case vuole. Resta sempre sullo stesso colore di casa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ходит по диагонали на любое число полей. Всегда остаётся на полях одного цвета."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿对角线走任意格数。始终停留在同色格上。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह तिरछे, जितने चाहे खाने चलता है। यह हमेशा एक ही रंग के खाने पर रहता है।"
          }
        }
      }
    },
    "Najjača figura na tabli. Kombinuje kretanje topa i lovca — horizontalno, vertikalno i dijagonalno.": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Najjača figura na tabli. Kombinuje kretanje topa i lovca — horizontalno, vertikalno i dijagonalno."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The strongest piece on the board. It combines the rook’s and bishop’s movement — horizontal, vertical and diagonal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La pièce la plus forte de l’échiquier. Elle combine les déplacements de la tour et du fou — horizontal, vertical et diagonal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die stärkste Figur auf dem Brett. Sie verbindet die Bewegung von Turm und Läufer — waagerecht, senkrecht und diagonal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pezzo più forte della scacchiera. Combina il movimento di torre e alfiere — orizzontale, verticale e diagonale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сильнейшая фигура на доске. Сочетает ход ладьи и слона — по горизонтали, вертикали и диагонали."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "棋盘上最强的棋子。它兼具车和象的走法——横、竖、斜皆可。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बोर्ड का सबसे मजबूत मोहरा। यह हाथी और ऊँट की चाल को मिलाता है — क्षैतिज, लंबवत और तिरछा।"
          }
        }
      }
    },
    "Kreće se jedno polje u bilo kom smeru. Ne sme stati na polje koje napada protivnik. Zaštiti ga!": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreće se jedno polje u bilo kom smeru. Ne sme stati na polje koje napada protivnik. Zaštiti ga!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It moves one square in any direction. It must not move to a square attacked by the opponent. Protect it!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il se déplace d’une case dans n’importe quelle direction. Il ne doit pas aller sur une case attaquée par l’adversaire. Protégez-le !"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zieht ein Feld in beliebige Richtung. Er darf nicht auf ein vom Gegner angegriffenes Feld ziehen. Beschütze ihn!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si muove di una casa in qualsiasi direzione. Non può andare su una casa attaccata dall’avversario. Proteggilo!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ходит на одно поле в любом направлении. Нельзя вставать на поле, атакованное соперником. Защищайте его!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向任意方向走一格。不能走到对手攻击的格子上。保护好它！"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह किसी भी दिशा में एक खाना चलता है। यह विरोधी द्वारा हमलाग्रस्त खाने पर नहीं जा सकता। इसकी रक्षा करें!"
          }
        }
      }
    },
    "Poseban potez: ako kralj i top nisu se još pomerali i između njih nema figura, kralj skoči dva polja ka topu, a top preskoči kralja. Tapni g1 (kratka rokada) ili c1 (duga rokada).": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poseban potez: ako kralj i top nisu se još pomerali i između njih nema figura, kralj skoči dva polja ka topu, a top preskoči kralja. Tapni g1 (kratka rokada) ili c1 (duga rokada)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A special move: if the king and rook have not yet moved and there are no pieces between them, the king jumps two squares toward the rook and the rook hops over the king. Tap g1 (kingside) or c1 (queenside)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un coup spécial : si le roi et la tour n’ont pas encore bougé et qu’aucune pièce ne les sépare, le roi saute de deux cases vers la tour et la tour franchit le roi. Touchez g1 (petit roque) ou c1 (grand roque)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein besonderer Zug: Wenn König und Turm noch nicht gezogen haben und keine Figur dazwischen steht, springt der König zwei Felder zum Turm und der Turm überspringt den König. Tippe g1 (kurze Rochade) oder c1 (lange Rochade)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una mossa speciale: se re e torre non si sono ancora mossi e non ci sono pezzi tra loro, il re salta due case verso la torre e la torre scavalca il re. Tocca g1 (arrocco corto) o c1 (arrocco lungo)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Особый ход: если король и ладья ещё не ходили и между ними нет фигур, король прыгает на два поля к ладье, а ладья перескакивает через короля. Коснитесь g1 (короткая рокировка) или c1 (длинная)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "特殊走法：如果王和车都还未移动且它们之间没有棋子，王朝车跳两格，车越过王。点按 g1（短易位）或 c1（长易位）。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विशेष चाल: यदि राजा और हाथी अभी तक नहीं हिले हैं और उनके बीच कोई मोहरा नहीं है, तो राजा हाथी की ओर दो खाने कूदता है और हाथी राजा के ऊपर से कूदता है। g1 (छोटी कैसलिंग) या c1 (बड़ी कैसलिंग) पर टैप करें।"
          }
        }
      }
    },
    "Posebno uzimanje pešakom: ako protivnički pešak skoči dva polja i nađe se pored tvojeg pešaka, možeš ga uzeti 'u prolazu' — kao da se pomerio samo jedno polje. Tapni d6.": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posebno uzimanje pešakom: ako protivnički pešak skoči dva polja i nađe se pored tvojeg pešaka, možeš ga uzeti 'u prolazu' — kao da se pomerio samo jedno polje. Tapni d6."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A special pawn capture: if an enemy pawn jumps two squares and lands beside your pawn, you may take it 'en passant' — as if it had moved only one square. Tap d6."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une prise spéciale du pion : si un pion adverse avance de deux cases et se retrouve à côté de votre pion, vous pouvez le prendre « en passant » — comme s’il n’avait avancé que d’une case. Touchez d6."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein besonderer Bauernschlag: Springt ein gegnerischer Bauer zwei Felder vor und landet neben deinem Bauern, darfst du ihn „en passant“ schlagen — als wäre er nur ein Feld gezogen. Tippe d6."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cattura speciale del pedone: se un pedone avversario salta di due case e si trova accanto al tuo, puoi prenderlo 'en passant' — come se avesse mosso di una sola casa. Tocca d6."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Особое взятие пешкой: если пешка соперника прыгает на два поля и оказывается рядом с вашей, вы можете взять её «на проходе» — как если бы она пошла на одно поле. Коснитесь d6."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "特殊的兵吃法：如果对方的兵跳两格并停在你的兵旁边，你可以「吃过路兵」——就像它只走了一格一样。点按 d6。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्यादे का विशेष मारना: यदि विरोधी प्यादा दो खाने कूदकर आपके प्यादे के बगल में आ जाए, तो आप उसे 'अन पासां' (चलते-चलते) मार सकते हैं — मानो वह केवल एक खाना चला हो। d6 पर टैप करें।"
          }
        }
      }
    },
    "Kad beli pešak stigne do osmog reda (redovi 8), može se pretvoriti u bilo koju figuru — gotovo uvek u damu. Tapni e8.": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad beli pešak stigne do osmog reda (redovi 8), može se pretvoriti u bilo koju figuru — gotovo uvek u damu. Tapni e8."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a white pawn reaches the eighth rank (row 8) it can turn into any piece — almost always a queen. Tap e8."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand un pion blanc atteint la huitième rangée (rangée 8), il peut se transformer en n’importe quelle pièce — presque toujours en dame. Touchez e8."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erreicht ein weißer Bauer die achte Reihe (Reihe 8), kann er sich in eine beliebige Figur verwandeln — fast immer in eine Dame. Tippe e8."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando un pedone bianco raggiunge l’ottava traversa (riga 8) può trasformarsi in qualsiasi pezzo — quasi sempre in donna. Tocca e8."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда белая пешка достигает восьмой горизонтали (ряд 8), она может превратиться в любую фигуру — почти всегда в ферзя. Коснитесь e8."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当白兵到达第八横线（第 8 行）时，它可升变为任意棋子——几乎总是后。点按 e8。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब सफ़ेद प्यादा आठवीं रैंक (पंक्ति 8) तक पहुँचता है, तो यह किसी भी मोहरे में बदल सकता है — लगभग हमेशा वज़ीर में। e8 पर टैप करें।"
          }
        }
      }
    },
