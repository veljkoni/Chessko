    "Korak se završava kad partija dođe do kraja." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schritt gilt als abgeschlossen, sobald die Partie zu Ende ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The step is completed once the game reaches its end."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'étape se termine lorsque la partie arrive à son terme."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बाज़ी के अंत तक पहुँचने पर यह चरण पूरा हो जाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il passo si completa quando la partita arriva alla fine."
          }
        },
        "ru" : {
          "stringUnit" : {
