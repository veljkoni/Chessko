          }
        }
      }
    },
    "Dva lovca su gotovo uvek jača od dva skakača": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dva lovca su gotovo uvek jača od dva skakača"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two bishops are almost always stronger than two knights"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux fous sont presque toujours plus forts que deux cavaliers"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Läufer sind fast immer stärker als zwei Springer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due alfieri sono quasi sempre più forti di due cavalli"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Два слона почти всегда сильнее двух коней"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双象几乎总是强于双马"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दो ऊँट लगभग हमेशा दो घोड़ों से मजबूत होते हैं"
          }
        }
      }
    },
    "Top vredi kao skakač plus dva piona": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Top vredi kao skakač plus dva piona"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A rook is worth a knight plus two pawns"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une tour vaut un cavalier plus deux pions"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Turm ist einen Springer plus zwei Bauern wert"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una torre vale un cavallo più due pedoni"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ладья стоит коня плюс две пешки"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一车价值相当于一马加两兵"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक हाथी एक घोड़े और दो प्यादों के बराबर है"
          }
        }
      }
    },
    "Kralj u završnici postaje napadačka figura": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kralj u završnici postaje napadačka figura"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the endgame the king becomes an attacking piece"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En finale, le roi devient une pièce d’attaque"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Endspiel wird der König zur Angriffsfigur"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel finale il re diventa un pezzo d’attacco"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В эндшпиле король становится атакующей фигурой"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "残局中国王成为进攻棋子"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अंत खेल में राजा एक हमलावर मोहरा बन जाता है"
          }
        }
      }
    },
    "\"Prva stvar koju učenik treba da uradi jeste da upozna snagu figura. Ovo se najlakše postiže učenjem kako se brzo postiže šah-mat.\"": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Prva stvar koju učenik treba da uradi jeste da upozna snagu figura. Ovo se najlakše postiže učenjem kako se brzo postiže šah-mat.\""
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"The first thing a student must do is become acquainted with the power of the pieces. This is best done by learning how to deliver checkmate quickly.\""
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« La première chose qu’un élève doit faire est de se familiariser avec la force des pièces. Le mieux est d’apprendre à mater rapidement. »"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Das Erste, was ein Schüler tun muss, ist die Kraft der Figuren kennenzulernen. Am besten lernt man dies, indem man schnell mattsetzt.“"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\"La prima cosa che uno studente deve fare è conoscere la forza dei pezzi. Il modo migliore è imparare a dare scacco matto rapidamente.\""
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Первое, что должен сделать ученик, — познакомиться с силой фигур. Лучше всего это даётся через умение быстро ставить мат.»"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“学习者首先要做的是了解棋子的力量。最好的方法就是学会快速将杀。”"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"छात्र को सबसे पहले मोहरों की ताकत से परिचित होना चाहिए। यह जल्दी शहमात देना सीखकर सबसे अच्छा होता है।\""
          }
        }
      }
    },
    "Šah se igra na tabli od **64 polja** naizmenično svetle i tamne boje. Uvek zapamti: **donje desno polje mora biti svetlo**. Svaki igrač počinje sa **16 figura**.": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Šah se igra na tabli od **64 polja** naizmenično svetle i tamne boje. Uvek zapamti: **donje desno polje mora biti svetlo**. Svaki igrač počinje sa **16 figura**."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chess is played on a board of **64 squares** that alternate light and dark. Always remember: **the bottom-right square must be light**. Each player starts with **16 pieces**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les échecs se jouent sur un échiquier de **64 cases** claires et foncées en alternance. Retenez toujours : **la case en bas à droite doit être claire**. Chaque joueur commence avec **16 pièces**."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schach wird auf einem Brett mit **64 Feldern** in abwechselnd hellen und dunklen Farben gespielt. Merke dir immer: **das Feld unten rechts muss hell sein**. Jeder Spieler beginnt mit **16 Figuren**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli scacchi si giocano su una scacchiera di **64 caselle** chiare e scure alternate. Ricorda sempre: **la casella in basso a destra deve essere chiara**. Ogni giocatore inizia con **16 pezzi**."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шахматы играются на доске из **64 полей** попеременно светлого и тёмного цвета. Всегда помните: **нижнее правое поле должно быть светлым**. Каждый игрок начинает с **16 фигурами**."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "国际象棋在 **64 格** 的棋盘上进行，深浅格交替。永远记住：**右下角必须是浅色格**。每方以 **16 个棋子** 开始。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शतरंज **64 खानों** के बोर्ड पर खेला जाता है जो हल्के और गहरे रंग के होते हैं। हमेशा याद रखें: **नीचे-दाईं ओर का खाना हल्का होना चाहिए**। हर खिलाड़ी **16 मोहरों** से शुरू करता है।"
          }
        }
      }
    },
    "Kapablanka kaže: vrednost nije fiksna — menja se zavisno od pozicije. Ipak, ove brojke služe kao vodič u razmeni figura.": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapablanka kaže: vrednost nije fiksna — menja se zavisno od pozicije. Ipak, ove brojke služe kao vodič u razmeni figura."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capablanca says: value is not fixed — it changes with the position. Still, these numbers serve as a guide when exchanging pieces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capablanca dit : la valeur n’est pas fixe — elle change selon la position. Ces chiffres servent toutefois de guide pour les échanges."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Capablanca sagt: Der Wert ist nicht fest — er ändert sich je nach Stellung. Dennoch dienen diese Zahlen als Leitfaden beim Abtausch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capablanca dice: il valore non è fisso — cambia con la posizione. Tuttavia questi numeri servono da guida negli scambi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Капабланка говорит: ценность не постоянна — она меняется в зависимости от позиции. И всё же эти числа служат ориентиром при разменах."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卡帕布兰卡说：价值并非固定——它随局面变化。不过这些数字在兑子时可作参考。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कापाब्लांका कहते हैं: मूल्य स्थिर नहीं है — यह स्थिति के अनुसार बदलता है। फिर भी ये अंक मोहरों की अदला-बदली में मार्गदर्शक हैं।"
          }
        }
      }
    },
    "Lovac je naročito snažan kada postoje pioni na obe strane table i kada su linije otvorene.": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lovac je naročito snažan kada postoje pioni na obe strane table i kada su linije otvorene."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bishop is especially strong when there are pawns on both sides of the board and the lines are open."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fou est particulièrement fort lorsqu’il y a des pions des deux côtés et que les lignes sont ouvertes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Läufer ist besonders stark, wenn auf beiden Seiten Bauern stehen und die Linien offen sind."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’alfiere è particolarmente forte quando ci sono pedoni su entrambi i lati e le linee sono aperte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слон особенно силён, когда пешки есть на обоих флангах и линии открыты."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当棋盘两侧都有兵且线路开放时，象尤为强大。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऊँट तब विशेष रूप से मजबूत होता है जब बोर्ड के दोनों ओर प्यादे हों और लाइनें खुली हों।"
          }
        }
      }
    },
    "Ili lovac plus dva piona. Zato se razmena figure za topa bez kompenzacije naziva \"gubljenje kvaliteta\".": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ili lovac plus dva piona. Zato se razmena figure za topa bez kompenzacije naziva \"gubljenje kvaliteta\"."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Or a bishop plus two pawns. That is why giving up a minor piece for a rook without compensation is called \"losing the exchange\"."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou un fou plus deux pions. C’est pourquoi céder une pièce mineure contre une tour sans compensation s’appelle « perdre la qualité »."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oder ein Läufer plus zwei Bauern. Deshalb nennt man das Hergeben einer Leichtfigur für einen Turm ohne Kompensation „Qualitätsverlust“."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppure un alfiere più due pedoni. Per questo cedere un pezzo minore per una torre senza compenso si chiama \"perdere la qualità\"."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Или слон плюс две пешки. Поэтому отдачу лёгкой фигуры за ладью без компенсации называют «потерей качества»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "或一象加两兵。因此无补偿地用轻子换车被称为“亏交换”。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "या एक ऊँट और दो प्यादे। इसीलिए बिना मुआवजे के हाथी के बदले छोटा मोहरा देना \"क्वालिटी गँवाना\" कहलाता है।"
          }
        }
      }
    },
    "U otvaranju i središnjici Kralj je isključivo odbrambena figura. U završnici, kada nestane većina figura, mora aktivno da učestvuje u borbi.": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "U otvaranju i središnjici Kralj je isključivo odbrambena figura. U završnici, kada nestane većina figura, mora aktivno da učestvuje u borbi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the opening and middlegame the king is purely a defensive piece. In the endgame, once most pieces are gone, it must take an active part in the fight."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En ouverture et milieu de partie, le roi est purement défensif. En finale, quand la plupart des pièces ont disparu, il doit participer activement au combat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Eröffnung und Mittelspiel ist der König rein defensiv. Im Endspiel, wenn die meisten Figuren weg sind, muss er aktiv am Kampf teilnehmen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In apertura e mediogioco il re è un pezzo puramente difensivo. Nel finale, quando la maggior parte dei pezzi è sparita, deve partecipare attivamente alla lotta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В дебюте и миттельшпиле король — чисто оборонительная фигура. В эндшпиле, когда большинства фигур не стало, он должен активно участвовать в борьбе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在开局和中局，国王纯属防守棋子。到了残局，大部分棋子消失后，它必须积极投入战斗。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ओपनिंग और मध्य खेल में राजा केवल रक्षात्मक मोहरा है। अंत खेल में, जब अधिकांश मोहरे चले जाते हैं, उसे सक्रिय रूप से लड़ाई में भाग लेना चाहिए।"
          }
        }
      }
    },
    "Pre nego što naučiš otvaranja i strategiju, nauči ove tri osnovne mat pozicije. Za svaki od njih potrebna je saradnja Kralja!": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre nego što naučiš otvaranja i strategiju, nauči ove tri osnovne mat pozicije. Za svaki od njih potrebna je saradnja Kralja!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before learning openings and strategy, master these three basic mating positions. Each of them needs the king’s cooperation!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant d’apprendre les ouvertures et la stratégie, maîtrisez ces trois mats de base. Chacun nécessite la coopération du roi !"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevor du Eröffnungen und Strategie lernst, beherrsche diese drei grundlegenden Mattbilder. Jedes davon braucht die Mithilfe des Königs!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima di imparare aperture e strategia, padroneggia queste tre posizioni di matto di base. Ognuna richiede la collaborazione del re!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прежде чем учить дебюты и стратегию, освойте эти три базовых матовых позиции. В каждой нужна помощь короля!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在学习开局和策略之前，先掌握这三种基本将杀。每一种都需要国王的配合！"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ओपनिंग और रणनीति सीखने से पहले, इन तीन बुनियादी मात स्थितियों में महारत हासिल करें। हर एक में राजा का सहयोग आवश्यक है!"
          }
        }
      }
    },
    "Vežba 1 — Kralj + Top": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vežba 1 — Kralj + Top"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exercise 1 — King + Rook"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exercice 1 — Roi + Tour"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übung 1 — König + Turm"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esercizio 1 — Re + Torre"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Упражнение 1 — король + ладья"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "练习 1——王 + 车"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभ्यास 1 — राजा + हाथी"
          }
        }
      }
    },
    "Oteraj crnog Kralja na ivicu table. Top i Kralj moraju da sarađuju!": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oteraj crnog Kralja na ivicu table. Top i Kralj moraju da sarađuju!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive the black king to the edge of the board. Rook and king must cooperate!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repoussez le roi noir au bord de l’échiquier. La tour et le roi doivent coopérer !"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Treibe den schwarzen König an den Brettrand. Turm und König müssen zusammenarbeiten!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spingi il re nero sul bordo della scacchiera. Torre e re devono collaborare!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оттесните чёрного короля к краю доски. Ладья и король должны действовать вместе!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把黑王逼到棋盘边缘。车和王必须配合！"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "काले राजा को बोर्ड के किनारे की ओर धकेलें। हाथी और राजा को मिलकर काम करना होगा!"
          }
        }
      }
    },
    "Vežba 2 — Kralj + dva Lovca": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vežba 2 — Kralj + dva Lovca"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exercise 2 — King + two Bishops"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exercice 2 — Roi + deux Fous"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übung 2 — König + zwei Läufer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esercizio 2 — Re + due Alfieri"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Упражнение 2 — король + два слона"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "练习 2——王 + 双象"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभ्यास 2 — राजा + दो ऊँट"
          }
        }
      }
    },
    "Oteraj Kralja ne samo na ivicu već i u ugao iste boje kao tvoji lovci.": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oteraj Kralja ne samo na ivicu već i u ugao iste boje kao tvoji lovci."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive the king not only to the edge but into a corner of the same colour as your bishops."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repoussez le roi non seulement au bord mais dans un coin de la même couleur que vos fous."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Treibe den König nicht nur an den Rand, sondern in eine Ecke der gleichen Farbe wie deine Läufer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spingi il re non solo sul bordo ma in un angolo dello stesso colore dei tuoi alfieri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оттесните короля не только к краю, но и в угол того же цвета, что и ваши слоны."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不仅要把王逼到边缘，还要逼进与你象同色的角落。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "राजा को केवल किनारे ही नहीं, बल्कि अपने ऊँटों के रंग के कोने में धकेलें।"
          }
        }
      }
    },
    "Vežba 3 — Kralj + Dama": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vežba 3 — Kralj + Dama"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exercise 3 — King + Queen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exercice 3 — Roi + Dame"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übung 3 — König + Dame"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esercizio 3 — Re + Donna"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Упражнение 3 — король + ферзь"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "练习 3——王 + 后"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभ्यास 3 — राजा + वज़ीर"
          }
        }
      }
    },
    "Najlakše! Dama odmah sužava prostor. Pazi na pat!": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Najlakše! Dama odmah sužava prostor. Pazi na pat!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The easiest! The queen immediately limits the space. Watch out for stalemate!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plus facile ! La dame réduit tout de suite l’espace. Attention au pat !"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am einfachsten! Die Dame schränkt den Raum sofort ein. Achte auf Patt!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il più facile! La donna limita subito lo spazio. Attento allo stallo!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Самое лёгкое! Ферзь сразу сужает пространство. Берегитесь пата!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最简单！后立刻压缩空间。小心逼和！"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबसे आसान! वज़ीर तुरंत जगह सीमित कर देता है। गतिरोध से सावधान!"
          }
        }
      }
    },
    "Na početku imaš 8 piona — oni su tvoja \"pešadija\". Kapablanka napominje: **dobitak jednog piona je najmanji materijalni dobitak i često je dovoljan za pobedu**.": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Na početku imaš 8 piona — oni su tvoja \"pešadija\". Kapablanka napominje: **dobitak jednog piona je najmanji materijalni dobitak i često je dovoljan za pobedu**."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At the start you have 8 pawns — they are your \"infantry\". Capablanca notes: **winning a single pawn is the smallest material gain and is often enough to win**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au début, vous avez 8 pions — c’est votre « infanterie ». Capablanca note : **gagner un seul pion est le plus petit gain matériel et suffit souvent à gagner**."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu Beginn hast du 8 Bauern — sie sind deine „Infanterie“. Capablanca merkt an: **ein einzelner Mehrbauer ist der kleinste materielle Gewinn und reicht oft zum Sieg**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "All’inizio hai 8 pedoni — sono la tua \"fanteria\". Capablanca osserva: **guadagnare un solo pedone è il più piccolo vantaggio materiale e spesso basta per vincere**."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В начале у вас 8 пешек — это ваша «пехота». Капабланка отмечает: **выигрыш одной пешки — наименьший материальный перевес, и его часто достаточно для победы**."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开局时你有 8 个兵——它们是你的“步兵”。卡帕布兰卡指出：**多赢一个兵是最小的物质优势，却常常足以取胜**。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरुआत में आपके पास 8 प्यादे होते हैं — ये आपकी \"पैदल सेना\" हैं। कापाब्लांका कहते हैं: **एक प्यादा जीतना सबसे छोटा भौतिक लाभ है और अक्सर जीत के लिए पर्याप्त होता है**।"
          }
        }
      }
    },
    "Ide isključivo napred, po jedno polje. Na prvom potezu može da preskoči dva polja. **Pioni ne mogu da idu unazad.**": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ide isključivo napred, po jedno polje. Na prvom potezu može da preskoči dva polja. **Pioni ne mogu da idu unazad.**"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It moves only forward, one square at a time. On its first move it may advance two squares. **Pawns cannot move backward.**"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il avance uniquement, d’une case à la fois. À son premier coup, il peut avancer de deux cases. **Les pions ne peuvent pas reculer.**"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zieht nur vorwärts, ein Feld nach dem anderen. Beim ersten Zug darf er zwei Felder vorrücken. **Bauern können nicht rückwärts ziehen.**"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avanza solo in avanti, una casa alla volta. Alla prima mossa può avanzare di due case. **I pedoni non possono andare indietro.**"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ходит только вперёд, на одно поле. Первым ходом может пойти на два поля. **Пешки не ходят назад.**"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只能向前走，每次一格。首步可走两格。**兵不能后退。**"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह केवल आगे, एक खाना चलता है। पहली चाल में दो खाने बढ़ सकता है। **प्यादे पीछे नहीं जा सकते।**"
          }
        }
      }
    },
    "Jede protivničke figure isključivo po dijagonali jedno polje unapred.": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede protivničke figure isključivo po dijagonali jedno polje unapred."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It captures enemy pieces only diagonally, one square ahead."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il capture les pièces adverses uniquement en diagonale, une case en avant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er schlägt gegnerische Figuren nur diagonal, ein Feld nach vorn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cattura i pezzi avversari solo in diagonale, una casa in avanti."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бьёт фигуры противника только по диагонали на одно поле вперёд."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只能斜向前一格吃子。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह विरोधी मोहरों को केवल तिरछे, एक खाना आगे मारता है।"
          }
        }
      }
    },
    "Ako pion stigne do poslednjeg reda — pretvara se u bilo koju figuru, najčešće Damu. Ovo je moćno oružje u završnici!": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako pion stigne do poslednjeg reda — pretvara se u bilo koju figuru, najčešće Damu. Ovo je moćno oružje u završnici!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If a pawn reaches the last rank it turns into any piece, most often a queen. This is a powerful weapon in the endgame!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un pion atteint la dernière rangée, il se transforme en n’importe quelle pièce, le plus souvent en dame. C’est une arme puissante en finale !"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erreicht ein Bauer die letzte Reihe, verwandelt er sich in eine beliebige Figur, meist in eine Dame. Im Endspiel ist das eine mächtige Waffe!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se un pedone raggiunge l’ultima traversa si trasforma in qualsiasi pezzo, di solito una donna. È un’arma potente nel finale!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если пешка доходит до последней горизонтали, она превращается в любую фигуру, чаще всего в ферзя. Это мощное оружие в эндшпиле!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果兵到达底线，它会升变为任意棋子，通常是后。这是残局中的强力武器！"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि कोई प्यादा अंतिम रैंक तक पहुँचता है, तो वह किसी भी मोहरे में, अक्सर वज़ीर में बदल जाता है। यह अंत खेल में शक्तिशाली हथियार है!"
          }
        }
      }
    },
    "Stoji u uglovima table na početku. Efikasan je tek na otvorenim linijama — koliko god radi sa pioima koji blokiraju put, toliko je ograničen.": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoji u uglovima table na početku. Efikasan je tek na otvorenim linijama — koliko god radi sa pioima koji blokiraju put, toliko je ograničen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It starts in the corners of the board. It becomes effective only on open lines — the more pawns block its path, the more limited it is."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle commence dans les coins de l’échiquier. Elle ne devient efficace que sur les lignes ouvertes — plus des pions bloquent son chemin, plus elle est limitée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er steht zu Beginn in den Brettecken. Erst auf offenen Linien wird er wirksam — je mehr Bauern den Weg versperren, desto eingeschränkter ist er."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte negli angoli della scacchiera. Diventa efficace solo sulle linee aperte — più pedoni bloccano il cammino, più è limitata."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В начале стоит по углам доски. Эффективна лишь на открытых линиях — чем больше пешек преграждает путь, тем она ограниченнее."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开局时位于棋盘的角落。只有在开放线上才有效——越多兵挡路，它就越受限。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह शुरुआत में बोर्ड के कोनों में रहता है। यह केवल खुली लाइनों पर प्रभावी होता है — जितने अधिक प्यादे रास्ता रोकते हैं, यह उतना ही सीमित होता है।"
          }
        }
      }
    },
    "Kreće se po pravim linijama (napred-nazad, levo-desno) koliko god polja želi. Zajedno, dva Topa su neznatno jača od Dame.": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreće se po pravim linijama (napred-nazad, levo-desno) koliko god polja želi. Zajedno, dva Topa su neznatno jača od Dame."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It moves in straight lines (up-down, left-right) as many squares as it likes. Together, two rooks are slightly stronger than a queen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle se déplace en lignes droites (haut-bas, gauche-droite) d’autant de cases qu’elle veut. Ensemble, deux tours sont un peu plus fortes qu’une dame."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zieht in geraden Linien (auf-ab, links-rechts) beliebig weit. Zusammen sind zwei Türme etwas stärker als eine Dame."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si muove in linea retta (su-giù, sinistra-destra) per quante case vuole. Insieme, due torri sono leggermente più forti di una donna."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ходит по прямым линиям (вверх-вниз, влево-вправо) на любое число полей. Вместе две ладьи чуть сильнее ферзя."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿直线（上下、左右）走任意格数。两车合力略强于一后。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सीधी रेखाओं में (ऊपर-नीचे, बाएँ-दाएँ) जितने चाहे खाने चलता है। मिलकर, दो हाथी एक वज़ीर से थोड़े मजबूत होते हैं।"
          }
        }
      }
    },
    "Jedan lovac uvek ostaje na belim, drugi na crnim poljima. Kapablanka smatra da je **u većini pozicija Lovac vredniji od Skakača**.": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedan lovac uvek ostaje na belim, drugi na crnim poljima. Kapablanka smatra da je **u većini pozicija Lovac vredniji od Skakača**."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One bishop always stays on the light squares, the other on the dark. Capablanca holds that **in most positions the bishop is worth more than the knight**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fou reste toujours sur les cases claires, l’autre sur les foncées. Capablanca estime que **dans la plupart des positions, le fou vaut plus que le cavalier**."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Läufer bleibt immer auf den hellen, der andere auf den dunklen Feldern. Capablanca meint, dass **der Läufer in den meisten Stellungen mehr wert ist als der Springer**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un alfiere resta sempre sulle case chiare, l’altro sulle scure. Capablanca ritiene che **nella maggior parte delle posizioni l’alfiere valga più del cavallo**."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один слон всегда остаётся на белых полях, другой — на чёрных. Капабланка считает, что **в большинстве позиций слон ценнее коня**."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一象始终在白格，另一象始终在黑格。卡帕布兰卡认为：**在多数局面中，象比马更有价值**。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक ऊँट हमेशा हल्के खानों पर, दूसरा गहरे खानों पर रहता है। कापाब्लांका मानते हैं कि **अधिकांश स्थितियों में ऊँट घोड़े से अधिक मूल्यवान है**।"
          }
        }
      }
    },
    "Kreće se isključivo po dijagonalama. Slabost: \"Topov pion koji promovira na polju suprotne boje od Lovca\" najčešće vodi remiju umesto pobede.": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreće se isključivo po dijagonalama. Slabost: \"Topov pion koji promovira na polju suprotne boje od Lovca\" najčešće vodi remiju umesto pobede."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It moves only along diagonals. Weakness: \"a rook pawn that promotes on a square of the opposite colour to the bishop\" most often leads to a draw instead of a win."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il se déplace uniquement en diagonale. Faiblesse : « un pion de tour qui promeut sur une case de couleur opposée au fou » mène le plus souvent à la nulle plutôt qu’au gain."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zieht nur auf Diagonalen. Schwäche: „ein Turmbauer, der auf einem Feld der Gegenfarbe des Läufers umwandelt“ führt meist zum Remis statt zum Sieg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si muove solo lungo le diagonali. Debolezza: \"un pedone di torre che promuove su una casa di colore opposto all’alfiere\" porta spesso alla patta invece che alla vittoria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ходит только по диагоналям. Слабость: «ладейная пешка, превращающаяся на поле, противоположном по цвету слону», чаще всего ведёт к ничьей, а не к победе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只能沿对角线走。弱点：“在与象异色的格子上升变的车兵”往往导致和棋而非胜利。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह केवल विकर्णों पर चलता है। कमजोरी: \"ऐसा हाथी-प्यादा जो ऊँट के विपरीत रंग के खाने पर प्रमोट होता है\" अक्सर जीत के बजाय ड्रॉ की ओर ले जाता है।"
          }
        }
      }
    },
    "Jedina figura koja preskače ostale. Snažan je u **zatvorenim pozicijama** — kada su linije blokirane pionima. Na ivici table gubi na snazi.": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedina figura koja preskače ostale. Snažan je u **zatvorenim pozicijama** — kada su linije blokirane pionima. Na ivici table gubi na snazi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The only piece that jumps over others. It is strong in **closed positions** — when the lines are blocked by pawns. On the edge of the board it loses strength."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La seule pièce qui saute par-dessus les autres. Il est fort dans les **positions fermées** — quand les lignes sont bloquées par des pions. Au bord de l’échiquier, il perd de sa force."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die einzige Figur, die über andere springt. Er ist stark in **geschlossenen Stellungen** — wenn die Linien von Bauern blockiert sind. Am Brettrand verliert er an Stärke."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’unico pezzo che salta gli altri. È forte nelle **posizioni chiuse** — quando le linee sono bloccate dai pedoni. Sul bordo della scacchiera perde forza."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Единственная фигура, перепрыгивающая через другие. Силён в **закрытых позициях** — когда линии перекрыты пешками. На краю доски теряет силу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "唯一能跳过其他棋子的棋子。它在**封闭局面**中很强——当线路被兵堵住时。在棋盘边缘则会减弱。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एकमात्र मोहरा जो दूसरों के ऊपर से कूदता है। यह **बंद स्थितियों** में मजबूत है — जब लाइनें प्यादों से अवरुद्ध हों। बोर्ड के किनारे पर यह कमजोर हो जाता है।"
          }
        }
      }
    },
    "Kreće se u obliku slova \"L\": dva polja pravo pa jedno u stranu.": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreće se u obliku slova \"L\": dva polja pravo pa jedno u stranu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It moves in an \"L\" shape: two squares straight, then one to the side."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il se déplace en forme de « L » : deux cases tout droit puis une sur le côté."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zieht in L-Form: zwei Felder gerade, dann eins zur Seite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si muove a forma di \"L\": due case dritto poi una di lato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ходит буквой «Г»: два поля прямо, затем одно в сторону."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "走“L”形：直走两格，再横走一格。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह \"L\" आकार में चलता है: दो खाने सीधे फिर एक बगल में।"
          }
        }
      }
    },
    "Jedina figura koja može da preskače druge figure — i svoje i protivničke!": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedina figura koja može da preskače druge figure — i svoje i protivničke!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The only piece that can jump over other pieces — both its own and the opponent’s!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La seule pièce qui peut sauter par-dessus d’autres pièces — les siennes comme celles de l’adversaire !"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die einzige Figur, die über andere Figuren springen kann — eigene wie gegnerische!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’unico pezzo che può saltare altri pezzi — sia i propri sia quelli avversari!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Единственная фигура, которая может перепрыгивать через другие — и свои, и чужие!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "唯一能跳过其他棋子的棋子——无论己方还是对方！"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एकमात्र मोहरा जो अन्य मोहरों के ऊपर से कूद सकता है — अपने और विरोधी दोनों के!"
          }
        }
      }
    },
    "Stoji na polju **svoje boje** — bela Dama na belom polju, crna na crnom. Najmoćnija figura, ali ne treba je odmah izvoditi u otvaranju.": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoji na polju **svoje boje** — bela Dama na belom polju, crna na crnom. Najmoćnija figura, ali ne treba je odmah izvoditi u otvaranju."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It stands on a square of **its own colour** — the white queen on a light square, the black on a dark one. The most powerful piece, but you shouldn’t develop it too early in the opening."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle se place sur une case de **sa couleur** — la dame blanche sur une case claire, la noire sur une foncée. La pièce la plus puissante, mais à ne pas sortir trop tôt en ouverture."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie steht auf einem Feld **ihrer eigenen Farbe** — die weiße Dame auf hellem, die schwarze auf dunklem Feld. Die stärkste Figur, doch man sollte sie in der Eröffnung nicht zu früh herausbringen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta su una casa del **proprio colore** — la donna bianca su casa chiara, la nera su scura. Il pezzo più potente, ma non va sviluppato troppo presto in apertura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стоит на поле **своего цвета** — белый ферзь на светлом поле, чёрный на тёмном. Самая мощная фигура, но не стоит выводить её слишком рано в дебюте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它位于**自己颜色**的格子上——白后在白格，黑后在黑格。最强大的棋子，但开局不宜过早出动。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह **अपने रंग** के खाने पर रहता है — सफ़ेद वज़ीर हल्के खाने पर, काला गहरे पर। सबसे शक्तिशाली मोहरा, पर ओपनिंग में इसे जल्दी बाहर नहीं लाना चाहिए।"
          }
        }
      }
    },
    "Kombinuje kretanje Topa i Lovca — kreće se u svim pravcima, koliko god polja želi.": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kombinuje kretanje Topa i Lovca — kreće se u svim pravcima, koliko god polja želi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It combines the rook’s and bishop’s movement — moving in all directions, as many squares as it likes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle combine les déplacements de la tour et du fou — dans toutes les directions, autant de cases qu’elle veut."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie verbindet die Bewegung von Turm und Läufer — in alle Richtungen, beliebig weit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Combina il movimento di torre e alfiere — in tutte le direzioni, per quante case vuole."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сочетает ход ладьи и слона — двигается во всех направлениях на любое число полей."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它兼具车和象的走法——可向任意方向走任意格数。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह हाथी और ऊँट की चाल को मिलाता है — सभी दिशाओं में, जितने चाहे खाने।"
          }
        }
      }
    },
    "Najvažnija figura — njen gubitak znači kraj igre. U otvaranju je **pasivna odbrambena figura**, ali u završnici postaje moćan napadač.": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Najvažnija figura — njen gubitak znači kraj igre. U otvaranju je **pasivna odbrambena figura**, ali u završnici postaje moćan napadač."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The most important piece — its loss means the end of the game. In the opening it is a **passive defensive piece**, but in the endgame it becomes a powerful attacker."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La pièce la plus importante — sa perte signifie la fin de la partie. En ouverture, c’est une **pièce défensive passive**, mais en finale, il devient un puissant attaquant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die wichtigste Figur — ihr Verlust bedeutet das Ende der Partie. In der Eröffnung ist er eine **passive Verteidigungsfigur**, im Endspiel wird er zum mächtigen Angreifer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pezzo più importante — la sua perdita significa la fine della partita. In apertura è un **pezzo difensivo passivo**, ma nel finale diventa un potente attaccante."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Самая важная фигура — её потеря означает конец игры. В дебюте это **пассивная оборонительная фигура**, но в эндшпиле он становится мощным атакующим."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最重要的棋子——失去它就意味着对局结束。开局中它是**被动的防守棋子**，但在残局中它会成为强大的进攻者。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबसे महत्वपूर्ण मोहरा — इसका खोना खेल का अंत है। ओपनिंग में यह एक **निष्क्रिय रक्षात्मक मोहरा** है, पर अंत खेल में यह शक्तिशाली हमलावर बन जाता है।"
          }
        }
      }
    },
    "Kreće se samo jedno polje u bilo kom pravcu. **Ne sme da stane na napadnuto polje!**": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreće se samo jedno polje u bilo kom pravcu. **Ne sme da stane na napadnuto polje!**"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It moves only one square in any direction. **It must not step onto an attacked square!**"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ne se déplace que d’une case dans n’importe quelle direction. **Il ne doit pas aller sur une case attaquée !**"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zieht nur ein Feld in beliebige Richtung. **Er darf kein angegriffenes Feld betreten!**"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si muove di una sola casa in qualsiasi direzione. **Non può andare su una casa attaccata!**"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ходит только на одно поле в любом направлении. **Нельзя становиться на атакованное поле!**"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它只能向任意方向走一格。**不能走到被攻击的格子上！**"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह किसी भी दिशा में केवल एक खाना चलता है। **यह हमलाग्रस्त खाने पर नहीं जा सकता!**"
          }
        }
      }
    },
    "Jednom u partiji možeš pomeriti **dve figure istovremeno** — Kralja i Topa. Kralj skoči dva polja ka Topu, a Top preskače Kralja i staje pored njega. Ovo služi da skloniš Kralja na sigurno i ubaciš Top u igru.": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednom u partiji možeš pomeriti **dve figure istovremeno** — Kralja i Topa. Kralj skoči dva polja ka Topu, a Top preskače Kralja i staje pored njega. Ovo služi da skloniš Kralja na sigurno i ubaciš Top u igru."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once per game you may move **two pieces at the same time** — the king and a rook. The king jumps two squares toward the rook, and the rook hops over the king to its side. This is used to put the king to safety and bring the rook into play."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois par partie, vous pouvez déplacer **deux pièces en même temps** — le roi et une tour. Le roi saute de deux cases vers la tour, et la tour franchit le roi pour se placer à côté. Cela met le roi à l’abri et active la tour."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal pro Partie darfst du **zwei Figuren gleichzeitig** ziehen — König und Turm. Der König springt zwei Felder zum Turm, der Turm überspringt den König und stellt sich daneben. So bringst du den König in Sicherheit und den Turm ins Spiel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una volta a partita puoi muovere **due pezzi contemporaneamente** — il re e una torre. Il re salta di due case verso la torre e la torre scavalca il re mettendosi accanto. Serve a mettere il re al sicuro e a portare la torre in gioco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один раз за партию вы можете сделать ход **двумя фигурами сразу** — королём и ладьёй. Король прыгает на два поля к ладье, а ладья перескакивает через короля и встаёт рядом. Это уводит короля в безопасность и вводит ладью в игру."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每盘棋有一次可以**同时移动两个棋子**——王和车。王朝车方向跳两格，车越过王落到其旁边。这能让王安全并使车投入战斗。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक खेल में एक बार आप **दो मोहरों को एक साथ** चला सकते हैं — राजा और हाथी। राजा हाथी की ओर दो खाने कूदता है, और हाथी राजा के ऊपर से कूदकर उसके बगल में आ जाता है। यह राजा को सुरक्षित करने और हाथी को खेल में लाने के लिए है।"
          }
        }
      }
    },
    "Ni Kralj ni Top se do tada **nisu pomerali** · Između njih **nema nijedne figure** · Kralj se ne nalazi u šahu i ne prolazi kroz napadnuto polje": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni Kralj ni Top se do tada **nisu pomerali** · Između njih **nema nijedne figure** · Kralj se ne nalazi u šahu i ne prolazi kroz napadnuto polje"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Neither king nor rook has **moved before** · There are **no pieces between them** · The king is not in check and does not pass through an attacked square"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni le roi ni la tour n’ont **bougé auparavant** · Il n’y a **aucune pièce entre eux** · Le roi n’est pas en échec et ne traverse pas de case attaquée"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weder König noch Turm haben sich **zuvor bewegt** · Zwischen ihnen steht **keine Figur** · Der König steht nicht im Schach und zieht nicht über ein angegriffenes Feld"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Né il re né la torre si sono **mossi prima** · Tra loro **non c’è alcun pezzo** · Il re non è sotto scacco e non attraversa una casa attaccata"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни король, ни ладья **ранее не ходили** · Между ними **нет фигур** · Король не под шахом и не проходит через атакованное поле"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "王和车此前**都未移动过** · 它们之间**没有任何棋子** · 王不在被将状态，且不经过被攻击的格子"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "न राजा न हाथी **पहले हिले हों** · उनके बीच **कोई मोहरा न हो** · राजा शह में न हो और किसी हमलाग्रस्त खाने से होकर न गुजरे"
          }
        }
      }
    },
    "\"Najvažnija stvar u otvaranju je brzo razviti figure. Nijedno parče ne treba pomeriti više od jednom pre nego što je razvoj završen, osim ako je to apsolutno neophodno.\"": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Najvažnija stvar u otvaranju je brzo razviti figure. Nijedno parče ne treba pomeriti više od jednom pre nego što je razvoj završen, osim ako je to apsolutno neophodno.\""
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"The most important thing in the opening is to develop the pieces quickly. No piece should be moved more than once before development is complete, unless it is absolutely necessary.\""
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Le plus important dans l’ouverture est de développer rapidement les pièces. Aucune pièce ne doit être déplacée plus d’une fois avant la fin du développement, sauf nécessité absolue. »"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Das Wichtigste in der Eröffnung ist die schnelle Entwicklung der Figuren. Keine Figur sollte vor Abschluss der Entwicklung mehr als einmal gezogen werden, außer es ist absolut notwendig.“"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\"La cosa più importante in apertura è sviluppare i pezzi rapidamente. Nessun pezzo va mosso più di una volta prima che lo sviluppo sia completo, a meno che non sia assolutamente necessario.\""
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Самое важное в дебюте — быстро развить фигуры. Ни одну фигуру не следует двигать более одного раза до завершения развития, если это не абсолютно необходимо.»"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“开局最重要的是快速出动棋子。在完成出子之前，除非绝对必要，任何棋子都不应移动超过一次。”"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"ओपनिंग में सबसे महत्वपूर्ण है मोहरों को तेज़ी से विकसित करना। विकास पूरा होने से पहले किसी मोहरे को एक बार से अधिक नहीं हिलाना चाहिए, जब तक नितांत आवश्यक न हो।\""
          }
        }
      }
    },
    "U šahu **Beli uvek igra prvi** i zbog toga ima blagu inicijalnu prednost. Zadatak oba igrača u otvaranju je isti: što brže dovesti figure u igru i zauzeti kontrolu nad centrom.": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "U šahu **Beli uvek igra prvi** i zbog toga ima blagu inicijalnu prednost. Zadatak oba igrača u otvaranju je isti: što brže dovesti figure u igru i zauzeti kontrolu nad centrom."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In chess **White always moves first** and therefore has a slight initial advantage. Both players’ task in the opening is the same: bring the pieces into play as fast as possible and take control of the centre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aux échecs, **les Blancs jouent toujours en premier** et ont donc un léger avantage initial. La tâche des deux joueurs en ouverture est identique : développer les pièces le plus vite possible et prendre le contrôle du centre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Schach **zieht Weiß immer zuerst** und hat dadurch einen kleinen Anfangsvorteil. Die Aufgabe beider Spieler in der Eröffnung ist dieselbe: die Figuren so schnell wie möglich ins Spiel bringen und die Kontrolle über das Zentrum übernehmen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Negli scacchi **il Bianco muove sempre per primo** e ha quindi un leggero vantaggio iniziale. Il compito di entrambi in apertura è lo stesso: portare i pezzi in gioco il più in fretta possibile e prendere il controllo del centro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В шахматах **белые всегда ходят первыми** и поэтому имеют небольшое начальное преимущество. Задача обоих игроков в дебюте одна: как можно быстрее ввести фигуры в игру и захватить контроль над центром."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在国际象棋中，**白方总是先走**，因此拥有微小的先手优势。双方在开局的任务相同：尽快出动棋子并控制中心。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शतरंज में **सफ़ेद हमेशा पहले चलता है** और इसलिए उसे थोड़ी शुरुआती बढ़त मिलती है। ओपनिंग में दोनों खिलाड़ियों का काम एक ही है: मोहरों को जल्द से जल्द खेल में लाना और केंद्र पर नियंत्रण पाना।"
          }
        }
      }
    },
    "Razvijaj figure brzo": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Razvijaj figure brzo"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Develop the pieces quickly"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Développez vite les pièces"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entwickle die Figuren schnell"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sviluppa i pezzi rapidamente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстро развивайте фигуры"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快速出动棋子"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मोहरों को जल्दी विकसित करें"
          }
        }
      }
    },
    "Kapablanka savetuje: skakače razvijaj pre lovaca. Ne pomeraj istu figuru dva puta u otvaranju ako nisi primoran. Svaki potez treba da razvija novu figuru ili kontroliše centar.": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapablanka savetuje: skakače razvijaj pre lovaca. Ne pomeraj istu figuru dva puta u otvaranju ako nisi primoran. Svaki potez treba da razvija novu figuru ili kontroliše centar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capablanca advises: develop knights before bishops. Don’t move the same piece twice in the opening unless forced. Every move should develop a new piece or control the centre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capablanca conseille : développez les cavaliers avant les fous. Ne déplacez pas deux fois la même pièce en ouverture sans y être contraint. Chaque coup doit développer une nouvelle pièce ou contrôler le centre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Capablanca rät: entwickle Springer vor Läufern. Ziehe dieselbe Figur in der Eröffnung nicht zweimal, wenn du nicht musst. Jeder Zug sollte eine neue Figur entwickeln oder das Zentrum kontrollieren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capablanca consiglia: sviluppa i cavalli prima degli alfieri. Non muovere lo stesso pezzo due volte in apertura se non costretto. Ogni mossa deve sviluppare un nuovo pezzo o controllare il centro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Капабланка советует: развивайте коней раньше слонов. Не ходите одной фигурой дважды в дебюте без необходимости. Каждый ход должен развивать новую фигуру или контролировать центр."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卡帕布兰卡建议：先出马后出象。开局中除非被迫，不要让同一棋子走两次。每一步都应出动新棋子或控制中心。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कापाब्लांका सलाह देते हैं: ऊँट से पहले घोड़े विकसित करें। मजबूरी न हो तो ओपनिंग में एक ही मोहरे को दो बार न हिलाएँ। हर चाल को नया मोहरा विकसित करना चाहिए या केंद्र पर नियंत्रण रखना चाहिए।"
          }
        }
      }
    },
    "Kontroliši centar": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontroliši centar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Control the centre"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôlez le centre"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrolliere das Zentrum"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla il centro"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контролируйте центр"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制中心"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केंद्र पर नियंत्रण रखें"
          }
        }
      }
    },
    "Četiri centralna polja (e4, d4, e5, d5) su najvažnija na tabli. Ko vlada centrom ima više prostora za manevar. Kapablanka: \"Nijedan žestok napad ne može uspeti bez kontrole bar dva centralna polja.\"": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Četiri centralna polja (e4, d4, e5, d5) su najvažnija na tabli. Ko vlada centrom ima više prostora za manevar. Kapablanka: \"Nijedan žestok napad ne može uspeti bez kontrole bar dva centralna polja.\""
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The four central squares (e4, d4, e5, d5) are the most important on the board. Whoever rules the centre has more room to manoeuvre. Capablanca: \"No vigorous attack can succeed without control of at least two central squares.\""
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les quatre cases centrales (e4, d4, e5, d5) sont les plus importantes de l’échiquier. Qui domine le centre a plus d’espace pour manœuvrer. Capablanca : « Aucune attaque vigoureuse ne peut réussir sans le contrôle d’au moins deux cases centrales. »"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die vier Zentralfelder (e4, d4, e5, d5) sind die wichtigsten auf dem Brett. Wer das Zentrum beherrscht, hat mehr Raum zum Manövrieren. Capablanca: „Kein energischer Angriff kann ohne Kontrolle über mindestens zwei Zentralfelder gelingen.“"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le quattro case centrali (e4, d4, e5, d5) sono le più importanti della scacchiera. Chi domina il centro ha più spazio per manovrare. Capablanca: \"Nessun attacco vigoroso può riuscire senza il controllo di almeno due case centrali.\""
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Четыре центральных поля (e4, d4, e5, d5) — важнейшие на доске. Кто владеет центром, имеет больше пространства для манёвра. Капабланка: «Ни одна энергичная атака не удастся без контроля хотя бы двух центральных полей.»"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "四个中心格（e4、d4、e5、d5）是棋盘上最重要的。掌控中心者拥有更多回旋空间。卡帕布兰卡：“任何猛烈的进攻，若不控制至少两个中心格，都无法成功。”"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चार केंद्रीय खाने (e4, d4, e5, d5) बोर्ड पर सबसे महत्वपूर्ण हैं। जो केंद्र पर राज करता है उसके पास अधिक जगह होती है। कापाब्लांका: \"कम से कम दो केंद्रीय खानों पर नियंत्रण के बिना कोई प्रबल हमला सफल नहीं हो सकता।\""
          }
        }
      }
    },
    "Zaštiti kralja — uradi rokadu!": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaštiti kralja — uradi rokadu!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protect the king — castle!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Protégez le roi — roquez !"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schütze den König — rochiere!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteggi il re — arrocca!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Защитите короля — рокируйте!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保护国王——王车易位！"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "राजा की रक्षा करें — कैसलिंग करें!"
          }
        }
      }
    },
    "Rokadu odigraj što pre je moguće. Kralj na otvorenom je laka meta. Kapablanka sam uvek rokira rano i preporučuje isto svim igračima, posebno početnicima.": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rokadu odigraj što pre je moguće. Kralj na otvorenom je laka meta. Kapablanka sam uvek rokira rano i preporučuje isto svim igračima, posebno početnicima."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Castle as early as possible. A king in the open is an easy target. Capablanca himself always castled early and recommends the same to all players, especially beginners."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Roquez le plus tôt possible. Un roi à découvert est une cible facile. Capablanca lui-même roquait toujours tôt et le recommande à tous, surtout aux débutants."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rochiere so früh wie möglich. Ein König im Freien ist ein leichtes Ziel. Capablanca selbst rochierte stets früh und empfiehlt dasselbe allen Spielern, besonders Anfängern."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrocca il prima possibile. Un re allo scoperto è un bersaglio facile. Capablanca stesso arroccava sempre presto e consiglia lo stesso a tutti, soprattutto ai principianti."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рокируйте как можно раньше. Король на открытом месте — лёгкая мишень. Сам Капабланка всегда рокировал рано и советует то же всем игрокам, особенно начинающим."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尽早王车易位。暴露的国王是容易的靶子。卡帕布兰卡本人总是早早易位，并建议所有人尤其是初学者也这样做。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जितनी जल्दी हो सके कैसलिंग करें। खुले में राजा आसान निशाना है। कापाब्लांका स्वयं हमेशा जल्दी कैसलिंग करते थे और सभी को, खासकर शुरुआती लोगों को यही सलाह देते हैं।"
          }
        }
      }
    },
    "Prerano izvođenje Dame": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prerano izvođenje Dame"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bringing the queen out too early"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortir la dame trop tôt"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dame zu früh herausbringen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sviluppare la donna troppo presto"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком ранний вывод ферзя"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过早出动皇后"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वज़ीर को बहुत जल्दी बाहर लाना"
          }
        }
      }
    },
    "Dama je snažna, ali ako je izvedeš rano, protivnik je napada pešacima i figurama — a svaki napad na Damu znači izgubljeni tempo jer mora da beži.": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dama je snažna, ali ako je izvedeš rano, protivnik je napada pešacima i figurama — a svaki napad na Damu znači izgubljeni tempo jer mora da beži."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The queen is strong, but if you bring her out early the opponent attacks her with pawns and pieces — and every attack on the queen means a lost tempo because she must flee."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dame est puissante, mais sortie tôt, l’adversaire l’attaque avec pions et pièces — et chaque attaque sur la dame coûte un tempo car elle doit fuir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dame ist stark, doch bringst du sie früh heraus, greift der Gegner sie mit Bauern und Figuren an — und jeder Angriff auf die Dame kostet ein Tempo, weil sie fliehen muss."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La donna è forte, ma se la sviluppi presto l’avversario la attacca con pedoni e pezzi — e ogni attacco alla donna costa un tempo perché deve fuggire."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ферзь силён, но если вывести его рано, соперник атакует его пешками и фигурами — а каждое нападение на ферзя означает потерю темпа, ведь он вынужден отступать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "皇后很强，但若过早出动，对手会用兵和子力攻击它——每次攻击皇后都意味着损失一步，因为它必须逃跑。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वज़ीर मजबूत है, पर यदि जल्दी बाहर लाएँ तो विरोधी प्यादों और मोहरों से उस पर हमला करता है — और वज़ीर पर हर हमला एक टेम्पो की हानि है क्योंकि उसे भागना पड़ता है।"
          }
        }
      }
    },
    "Pasivna odbrana pionima": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasivna odbrana pionima"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passive defence with pawns"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Défense passive avec les pions"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passive Verteidigung mit Bauern"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Difesa passiva con i pedoni"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пассивная защита пешками"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用兵被动防守"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्यादों से निष्क्रिय बचाव"
          }
        }
      }
    },
    "\"Filipidorski\" stil — odmah igrati P-d6 kao odgovor na e4 — daje protivniku slobodan razvoj i prostranstvo. Kapablanka pokazuje kako beli tada lako gradi superiornu poziciju.": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Filipidorski\" stil — odmah igrati P-d6 kao odgovor na e4 — daje protivniku slobodan razvoj i prostranstvo. Kapablanka pokazuje kako beli tada lako gradi superiornu poziciju."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The \"Philidor\" style — answering e4 immediately with P-d6 — gives the opponent free development and space. Capablanca shows how White then easily builds a superior position."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le style « Philidor » — répondre à e4 immédiatement par P-d6 — offre à l’adversaire développement et espace. Capablanca montre comment les Blancs construisent alors aisément une position supérieure."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der „Philidor“-Stil — auf e4 sofort mit P-d6 zu antworten — gibt dem Gegner freie Entwicklung und Raum. Capablanca zeigt, wie Weiß dann leicht eine überlegene Stellung aufbaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo stile \"Philidor\" — rispondere a e4 subito con P-d6 — dà all’avversario sviluppo libero e spazio. Capablanca mostra come il Bianco costruisca poi facilmente una posizione superiore."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стиль «Филидора» — отвечать на e4 сразу P-d6 — даёт сопернику свободное развитие и пространство. Капабланка показывает, как белые затем легко строят превосходную позицию."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“费利多尔”式——对 e4 立刻以 P-d6 应对——会让对手获得自由出子和空间。卡帕布兰卡展示了白方如何因此轻松建立优势局面。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"फिलिडोर\" शैली — e4 के जवाब में तुरंत P-d6 खेलना — विरोधी को मुक्त विकास और जगह देती है। कापाब्लांका दिखाते हैं कि सफ़ेद तब कैसे आसानी से बेहतर स्थिति बना लेता है।"
          }
        }
      }
    },
    "Zakasnela rokada": {
      "extractionState": "manual",
      "localizations": {
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakasnela rokada"
          }
        },
        "en": {
