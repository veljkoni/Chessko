          "value": 0
        }
      ]
    },
    {
      "type": "bullets",
      "items": [
        {
          "icon": "info.circle.fill",
          "title": "双象几乎总是强于双马",
          "text": "当棋盘两侧都有兵且线路开放时，象尤为强大。",
          "style": null
        },
        {
          "icon": "info.circle.fill",
          "title": "一车价值相当于一马加两兵",
          "text": "或一象加两兵。因此无补偿地用轻子换车被称为“亏交换”。",
          "style": null
        },
        {
          "icon": "crown.fill",
          "title": "残局中国王成为进攻棋子",
          "text": "在开局和中局，国王纯属防守棋子。到了残局，大部分棋子消失后，它必须积极投入战斗。",
          "style": null
        }
      ]
    },
    {
      "type": "heading",
      "text": "基本将杀",
      "icon": "checkmark.seal.fill"
    },
    {
      "type": "paragraph",
      "text": "在学习开局和策略之前，先掌握这三种基本将杀。每一种都需要国王的配合！"
    },
    {
